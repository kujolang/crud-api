export func get_header(req, header_name) {
	header_values := req["header_values"]
	key := to_lower(header_name)
	if has_key(header_values, key) {
		values := header_values[key]
		if len(values) == 1 { return values[0] }
	}
	return ""
}

export func begin_request(req) {
	request_id := trim(get_header(req, "X-Request-Id"))
	if len(request_id) > 128 || !regex_match(request_id, "^[A-Za-z0-9._:-]+$") {
		request_id = "req-" + uuid_v4()
	}
	req["request_id"] = request_id
	return req
}
