export func log_event(req, level, event_name, details) {
	entry := {
		"ts": now(),
		"level": level,
		"event": event_name,
		"request_id": req["request_id"],
		"method": req["method"],
		"path": req["path"],
		"details": details
	}
	print(to_json(entry))
}

export func log_request_start(req) {
	log_event(req, "info", "request.start", {})
}

export func log_request_complete(req, status_code) {
	log_event(req, "info", "request.complete", {
		"status": status_code
	})
}

export func log_security_event(req, event_name, reason) {
	log_event(req, "warn", event_name, {
		"reason": reason
	})
}
