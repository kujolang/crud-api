from src.config import TRUST_PROXY_HEADERS, parse_int_env
from src.request_context import get_header

WINDOW_SECONDS := parse_int_env("KUJO_CRUD_RATE_LIMIT_WINDOW_SECONDS", 60)
MAX_WRITES_PER_WINDOW := parse_int_env("KUJO_CRUD_RATE_LIMIT_MAX_WRITES", 30)
MAX_ACTIVE_CLIENTS := 4096

rate_db := db_connect("sqlite", ":memory:")
db_execute(rate_db, "CREATE TABLE write_buckets (client TEXT PRIMARY KEY, expires_ms INTEGER NOT NULL, count INTEGER NOT NULL)", [])
db_execute(rate_db, "CREATE INDEX write_buckets_expiry ON write_buckets(expires_ms)", [])

func rate_limit_key(req) {
	if TRUST_PROXY_HEADERS {
		forwarded := get_header(req, "X-Forwarded-For")
		if len(forwarded) > 0 && len(forwarded) <= 512 {
			client := trim(split(forwarded, ",")[0])
			if len(client) <= 45 && regex_match(client, "^[0-9A-Fa-f:.]+$") {
				return "proxy-ip:" + to_lower(client)
			}
		}
	}
	if len(req["peer_ip"]) > 0 { return "ip:" + req["peer_ip"] }
	return "global"
}

export func check_write_rate_limit(req) {
	client := rate_limit_key(req)
	now_ms := to_int(performance_now())
	expires_ms := now_ms + WINDOW_SECONDS * 1000
	try {
		db_execute(rate_db, "DELETE FROM write_buckets WHERE expires_ms <= ?", [now_ms])
		admitted := db_query(rate_db, "INSERT INTO write_buckets (client, expires_ms, count) SELECT ?1, ?2, 1 WHERE EXISTS (SELECT 1 FROM write_buckets WHERE client = ?1) OR (SELECT COUNT(*) FROM write_buckets) < ?4 ON CONFLICT(client) DO UPDATE SET count = count + 1 WHERE count < ?3 RETURNING count", [client, expires_ms, MAX_WRITES_PER_WINDOW, MAX_ACTIVE_CLIENTS])
		if len(admitted) > 0 { return {"ok": true} }

		blocked := db_query(rate_db, "SELECT expires_ms FROM write_buckets WHERE client = ?", [client])
		retry_after := 1
		if len(blocked) > 0 {
			remaining_ms := blocked[0]["expires_ms"] - now_ms
			retry_after = max(1, to_int(ceil(remaining_ms / 1000.0)))
		}
		return {"ok": false, "status": 429, "error": "Too many write requests", "retry_after": retry_after}
	} except err {
		return {"ok": false, "status": 503, "error": "Write rate limit unavailable", "retry_after": 1}
	}
}
