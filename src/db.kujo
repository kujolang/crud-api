from src.config import DB_PATH

export db := db_connect("sqlite", DB_PATH)
if type(db) == "error" {
	print("Failed to connect to SQLite database: " + to_string(db))
	exit(1)
}

export func db_query_safe(sql, params) {
	rows := db_query(db, sql, params)
	if type(rows) == "error" {
		return {"ok": false, "error": to_string(rows)}
	}
	return {"ok": true, "rows": rows}
}

export func db_execute_safe(sql, params) {
	result := db_execute(db, sql, params)
	if type(result) == "error" {
		return {"ok": false, "error": to_string(result)}
	}
	return {"ok": true, "result": result}
}

pragma_steps := [
	"PRAGMA journal_mode=WAL",
	"PRAGMA synchronous=NORMAL",
	"PRAGMA temp_store=MEMORY",
	"PRAGMA foreign_keys=ON",
	"PRAGMA busy_timeout=5000"
]

for sql in pragma_steps {
	pragma_result := db_query_safe(sql, [])
	if !pragma_result["ok"] {
		print("Database PRAGMA setup failed: " + pragma_result["error"])
		exit(1)
	}
}

schema_steps := [
	{"sql": "CREATE TABLE IF NOT EXISTS projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE, description TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "params": []},
	{"sql": "CREATE INDEX IF NOT EXISTS idx_projects_name ON projects(name)", "params": []},
	{"sql": "CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, content TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "params": []},
	{"sql": "CREATE INDEX IF NOT EXISTS idx_items_status ON items(status)", "params": []},
	{"sql": "CREATE INDEX IF NOT EXISTS idx_items_updated_at ON items(updated_at)", "params": []}
]

for step in schema_steps {
	init_result := db_execute_safe(step["sql"], step["params"])
	if !init_result["ok"] {
		print("Database schema setup failed: " + init_result["error"])
		exit(1)
	}
}

table_info_result := db_query_safe("PRAGMA table_info(items)", [])
if !table_info_result["ok"] {
	print("Database schema introspection failed: " + table_info_result["error"])
	exit(1)
}

has_project_id_column := false
for column_info in table_info_result["rows"] {
	if has_key(column_info, "name") && to_string(column_info["name"]) == "project_id" {
		has_project_id_column := true
	}
}

if !has_project_id_column {
	alter_result := db_execute_safe("ALTER TABLE items ADD COLUMN project_id INTEGER REFERENCES projects(id) ON DELETE SET NULL", [])
	if !alter_result["ok"] {
		print("Database schema migration failed: " + alter_result["error"])
		exit(1)
	}
}

project_index_result := db_execute_safe("CREATE INDEX IF NOT EXISTS idx_items_project_id ON items(project_id)", [])
if !project_index_result["ok"] {
	print("Database index setup failed: " + project_index_result["error"])
	exit(1)
}

seeded_items_count := 0
seeded_projects_count := 0

project_seed_fixtures := [
	{"name": "Documentation", "description": "API and developer documentation roadmap and examples."},
	{"name": "Website", "description": "Frontend and UI experience work tracked independently."},
	{"name": "Operations", "description": "Runtime hardening, observability, and deployment baseline tasks."}
]

for project_fixture in project_seed_fixtures {
	project_existing := db_query(db, "SELECT COUNT(*) AS total FROM projects WHERE name = ?", [project_fixture["name"]])
	if type(project_existing) == "error" {
		print("Project seed check failed: " + to_string(project_existing))
		exit(1)
	}

	if len(project_existing) > 0 && project_existing[0]["total"] == 0 {
		project_stamp := now()
		project_insert := db_execute(db, "INSERT INTO projects (name, description, created_at, updated_at) VALUES (?, ?, ?, ?)", [project_fixture["name"], project_fixture["description"], project_stamp, project_stamp])
		if type(project_insert) == "error" {
			print("Project sample data seed failed: " + to_string(project_insert))
			exit(1)
		}
		seeded_projects_count := seeded_projects_count + 1
	}
}

seed_fixtures := [
	{"title": "First Sample Item", "content": "Use this record to test read and update flows.", "status": "published", "project_name": "Documentation"},
	{"title": "Draft Work Item", "content": "A draft record for testing filtered list responses.", "status": "draft", "project_name": "Website"},
	{"title": "Archived Reference Item", "content": "An archived record useful for lifecycle state examples.", "status": "archived", "project_name": "Operations"},
	{"title": "Integration Test Fixture", "content": "Use this to validate pagination and deterministic ordering.", "status": "published", "project_name": "Documentation"},
	{"title": "Sample Patch Target", "content": "Designed for quick PATCH requests while experimenting.", "status": "draft", "project_name": "Website"}
]

for fixture in seed_fixtures {
	seed_existing := db_query(db, "SELECT COUNT(*) AS total FROM items WHERE title = ?", [fixture["title"]])
	if type(seed_existing) == "error" {
		print("Database seed check failed: " + to_string(seed_existing))
		exit(1)
	}

	if len(seed_existing) > 0 && seed_existing[0]["total"] == 0 {
		project_id := null
		if has_key(fixture, "project_name") {
			project_lookup := db_query(db, "SELECT id FROM projects WHERE name = ? LIMIT 1", [fixture["project_name"]])
			if type(project_lookup) == "error" {
				print("Project lookup for seed fixture failed: " + to_string(project_lookup))
				exit(1)
			}

			if len(project_lookup) > 0 {
				project_id := project_lookup[0]["id"]
			}
		}

		seed_stamp := now()
		seed_insert := db_execute(db, "INSERT INTO items (title, content, status, created_at, updated_at, project_id) VALUES (?, ?, ?, ?, ?, ?)", [fixture["title"], fixture["content"], fixture["status"], seed_stamp, seed_stamp, project_id])
		if type(seed_insert) == "error" {
			print("Sample data seed failed: " + to_string(seed_insert))
			exit(1)
		}
		seeded_items_count := seeded_items_count + 1
	}
}

if seeded_projects_count > 0 {
	print("Ensured project content. Inserted projects: " + to_string(seeded_projects_count))
}

if seeded_items_count > 0 {
	print("Ensured demo content. Inserted items: " + to_string(seeded_items_count))
}
